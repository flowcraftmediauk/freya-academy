rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAppAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'flowcraftmediauk@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidSiteConfig(data) {
      return data.keys().hasOnly([
        'businessName', 'logoUrl', 'tagline', 'businessDescription',
        'heroHeadline', 'heroSubheading', 'ctaText', 'heroImageUrl',
        'aboutHeading', 'aboutDescription', 'aboutImageUrl',
        'email', 'phone', 'whatsapp', 'whatsappUrl', 'facebookUrl', 'instagramUrl',
        'address', 'openingHours',
        'updatedAt', 'updatedBy'
      ]) &&
      data.updatedAt is string && data.updatedAt.size() <= 50 &&
      (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 120)) &&
      (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 500)) &&
      (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 200)) &&
      (!('businessDescription' in data) || (data.businessDescription is string && data.businessDescription.size() <= 2000)) &&
      (!('heroHeadline' in data) || (data.heroHeadline is string && data.heroHeadline.size() <= 160)) &&
      (!('heroSubheading' in data) || (data.heroSubheading is string && data.heroSubheading.size() <= 500)) &&
      (!('ctaText' in data) || (data.ctaText is string && data.ctaText.size() <= 60)) &&
      (!('heroImageUrl' in data) || (data.heroImageUrl is string && data.heroImageUrl.size() <= 500)) &&
      (!('aboutHeading' in data) || (data.aboutHeading is string && data.aboutHeading.size() <= 160)) &&
      (!('aboutDescription' in data) || (data.aboutDescription is string && data.aboutDescription.size() <= 2000)) &&
      (!('aboutImageUrl' in data) || (data.aboutImageUrl is string && data.aboutImageUrl.size() <= 500)) &&
      (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
      (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
      (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 50)) &&
      (!('whatsappUrl' in data) || (data.whatsappUrl is string && data.whatsappUrl.size() <= 500)) &&
      (!('facebookUrl' in data) || (data.facebookUrl is string && data.facebookUrl.size() <= 500)) &&
      (!('instagramUrl' in data) || (data.instagramUrl is string && data.instagramUrl.size() <= 500)) &&
      (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
      (!('openingHours' in data) || (data.openingHours is string && data.openingHours.size() <= 200)) &&
      (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    function isValidServiceItem(data) {
      return data.keys().hasAll(['title', 'order']) &&
      data.keys().hasOnly(['title', 'description', 'imageUrl', 'ctaText', 'order', 'createdAt']) &&
      data.title is string && data.title.size() <= 100 &&
      data.order is number &&
      (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
      (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500)) &&
      (!('ctaText' in data) || (data.ctaText is string && data.ctaText.size() <= 60)) &&
      (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['fullName', 'status', 'createdAt']) &&
      data.keys().hasOnly(['fullName', 'email', 'phone', 'preferredDate', 'service', 'notes', 'status', 'createdAt']) &&
      data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
      data.status in ['pending', 'confirmed', 'completed', 'cancelled'] &&
      data.createdAt is string && data.createdAt.size() <= 50 &&
      (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
      (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
      (!('preferredDate' in data) || (data.preferredDate is string && data.preferredDate.size() <= 50)) &&
      (!('service' in data) || (data.service is string && data.service.size() <= 100)) &&
      (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    // Site configuration collection
    match /sites/{siteId} {
      allow read: if isValidId(siteId);
      allow create: if isValidId(siteId) && isSignedIn() && isValidSiteConfig(incoming());
      allow update: if isValidId(siteId) && isSignedIn() && isValidSiteConfig(incoming());
      allow delete: if isValidId(siteId) && isAppAdmin();

      // Services subcollection
      match /services/{serviceId} {
        allow read: if isValidId(siteId) && isValidId(serviceId);
        allow create: if isValidId(siteId) && isValidId(serviceId) && isSignedIn() && isValidServiceItem(incoming());
        allow update: if isValidId(siteId) && isValidId(serviceId) && isSignedIn() && isValidServiceItem(incoming());
        allow delete: if isValidId(siteId) && isValidId(serviceId) && isSignedIn();
      }
    }

    // Appointments collection
    match /appointments/{appointmentId} {
      // PII Protection: only authenticated staff/admin can list or get individual appointments
      allow get, list: if isSignedIn();
      
      // Public visitors can submit consultation requests with initial status 'pending'
      allow create: if isValidId(appointmentId) &&
        isValidAppointment(incoming()) &&
        incoming().status == 'pending';

      // Updates and deletions restricted to authenticated staff/admin
      allow update: if isValidId(appointmentId) &&
        isSignedIn() &&
        isValidAppointment(incoming());
      allow delete: if isValidId(appointmentId) && isSignedIn();
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAppAdmin();
    }
  }
}
